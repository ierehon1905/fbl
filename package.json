{
  "name": "factorio-lang",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Lisp for describing Factorio blueprints, with a live preview studio.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/stamp-atlas.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch-data": "node scripts/fetch-data.mjs",
    "test": "node scripts/build-core.mjs && node --test tests/*.test.mjs",
    "build:core": "node scripts/build-core.mjs",
    "stamp-atlas": "node scripts/stamp-atlas.mjs",
    "extract-sprites": "node scripts/build-core.mjs && node scripts/extract-sprites.mjs",
    "extract-balancers": "node scripts/build-core.mjs && node scripts/extract-balancers.mjs",
    "audit": "node scripts/build-core.mjs && node scripts/audit-recipes.mjs 2x1 spa 2.0 1.1",
    "charts": "node scripts/build-core.mjs && node scripts/quality-charts.mjs && node scripts/quality-race.mjs && python3 scripts/quality-charts.py"
  },
  "dependencies": {
    "monaco-editor": "^0.56.0",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/pako": "^2.0.3",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
